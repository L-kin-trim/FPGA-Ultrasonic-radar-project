<chipwatcher project_name="DaChuang" bit_file="DaChuang_Runs/phy_1/DaChuang.bit" bid_file="DaChuang_Runs/phy_1/DaChuang_inst.bid" chip_name="EG4S20BG256">
<!-- HMAC is: 79f736d236a13b34143af382ea5a9f2f4c8abdc03ac0f6fb8a49fdd8355dd09d -->
	<instance name="auto_chipwatcher_0" id="0" enabled="yes">
		<clock clk_name="clk" polarity="posedge"/>
		<config bram_name="auto_chipwatcher_0_logicbram" sample_depth="8192"/>
		<signal_vec>
			<data_nets>
				<net name="echo"/>
				<net name="trig"/>
			</data_nets>
			<watcher_nodes>
				<net name="trig" op="equal" type="output" trigger="enable"/>
				<net name="echo" op="equal" type="input" trigger="enable"/>
			</watcher_nodes>
		</signal_vec>
		<trigger name="auto_chipwatcher_0_trigger" position="pre">
			<condition level="1" enabled="yes" type="basic_and">
				echo == falling && trig == any
			</condition>
			<log>
				<data name="log: 2025/11/18 20: 2:36" trigger_en="yes" trigger_pos="2048" sample_num="8192">
					
				</data>
			</log>
		</trigger>
	</instance>
</chipwatcher>
